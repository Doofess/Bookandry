{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,

    /* §12: strict, zero any. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Deliberately OFF. `Override.patch` and other Partial<Pick<...>> shapes
       cannot express "set this field to undefined" under exactOptionalPropertyTypes,
       which turns clearing a note into an afternoon of type surgery for no safety win.
       Do not enable without reworking those types first. */
    "exactOptionalPropertyTypes": false,

    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client", "vite-plugin-pwa/react"]
  },
  "include": ["src", "src/**/*.json"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**", "e2e/**"]
}
