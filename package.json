{
  "name": "greenback",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env TZ=Etc/UTC vitest run",
    "test:watch": "cross-env TZ=Etc/UTC vitest",
    "test:cov": "cross-env TZ=Etc/UTC vitest run --coverage",
    "test:e2e": "playwright test",
    "gate:rtl": "node scripts/gate-rtl.mjs",
    "gate:money": "node scripts/gate-money.mjs",
    "gate:pci": "node scripts/gate-pci.mjs",
    "gates": "pnpm gate:rtl && pnpm gate:money && pnpm gate:pci",
    "icons": "pwa-assets-generator",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm gates && pnpm test:cov && pnpm build",
    "verify:full": "pnpm verify && pnpm knip && pnpm test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/heebo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "^0.3.0",
    "d3-scale": "4.0.2",
    "date-fns": "^4.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "i18next": "26.4.2",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "17.0.14",
    "react-is": "19.3.0",
    "react-router-dom": "7.18.3",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "6.2.5",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "globby": "^16.2.4",
    "jsdom": "30.0.1",
    "knip": "^6.35.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
