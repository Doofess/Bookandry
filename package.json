{
  "name": "bookandry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "build:local": "cross-env VITE_SUPABASE_URL= VITE_SUPABASE_PUBLISHABLE_KEY= vite build --outDir dist-local",
    "preview:local": "vite preview --outDir dist-local --port 4173 --strictPort",
    "release": "pnpm verify && npx --yes wrangler@4 deploy",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env TZ=Etc/UTC vitest run",
    "test:watch": "cross-env TZ=Etc/UTC vitest",
    "test:cov": "cross-env TZ=Etc/UTC vitest run --coverage",
    "test:e2e": "playwright test",
    "gate:rtl": "node scripts/gate-rtl.mjs",
    "gate:money": "node scripts/gate-money.mjs",
    "gate:pci": "node scripts/gate-pci.mjs",
    "data:banks": "node scripts/fetch-bank-branches.mjs",
    "data:mcc": "node scripts/build-mcc.mjs",
    "emails": "node scripts/emails.mjs",
    "gates": "pnpm gate:rtl && pnpm gate:money && pnpm gate:pci",
    "icons": "pwa-assets-generator",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm gates && pnpm test:cov && pnpm build",
    "verify:full": "pnpm verify && pnpm test:tz && pnpm knip && pnpm test:e2e && pnpm lighthouse",
    "test:tz": "node scripts/test-hostile-tz.mjs",
    "lighthouse": "lhci autorun",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource/ibm-plex-sans-hebrew": "5.3.0",
    "@fontsource/karantina": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.3.0",
    "d3-scale": "4.0.2",
    "date-fns": "^4.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "hash-wasm": "4.12.0",
    "i18next": "26.4.2",
    "lucide-react": "1.46.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "17.0.14",
    "react-is": "19.3.0",
    "react-router-dom": "7.18.3",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "6.2.5",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "globby": "^16.2.4",
    "jsdom": "30.0.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
